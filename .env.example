# Supabase SESSION pooler URI (port 5432). Do not use the transaction pooler (6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"
GEMINI_API_KEY="<google-ai-studio-key>"
GEMINI_MODEL_PRIMARY="gemini-3.6-flash"
GEMINI_MODEL_FALLBACK="gemini-3.5-flash-lite"
AI_DAILY_CALL_CAP="600"
EVAL_TOKEN="<random-string>"
CRON_SECRET="<random-string>"
